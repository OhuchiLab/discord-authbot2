# ===== Discord =====
# Discord Developer Portal > Applications > Bot > Token
DISCORD_TOKEN=
# Bot を動かすサーバーの ID (Discord の開発者モードを有効にし、サーバー名を右クリック > 「サーバーIDをコピー」)
GUILD_ID=

# ===== データベース =====
# 学生情報を保存するファイル (省略時: data/students.msgpack)
DATABASE_PATH=data/students.msgpack
# 受け付けるメールアドレスのドメイン (省略時: shizuoka.ac.jp)
ALLOWED_EMAIL_DOMAIN=shizuoka.ac.jp

# ===== 認証メール送信 (SMTP) =====
# Gmail の例: SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USE_STARTTLS=true / SMTP_PASSWORD にはアプリパスワード
# テスト用 Mailpit の例: SMTP_HOST=localhost / SMTP_PORT=1025 / SMTP_USE_STARTTLS=false / SMTP_USER と SMTP_PASSWORD は空
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
# ログインしない場合は空にする
SMTP_USER=
SMTP_PASSWORD=
# 差出人アドレス (省略時: SMTP_USER。SMTP_USER が空なら必須)
MAIL_FROM=

# ===== バックアップ =====
# 学生情報ファイルを保存するたび (と起動時) に、日時付きのコピーを残す場所 (省略時: data/backups)
# ディスクの故障に備えるなら、外付けディスクや NAS をマウントした場所を指定する
BACKUP_DIR=data/backups
# 残すコピーの数 (省略時: 50。0 にするとバックアップを取らない)
BACKUP_KEEP=50

# ===== 変更履歴のログ =====
# 管理者の操作・認証完了・Bot の起動を投稿するチャンネル名 (省略時: authbot-logs。空にすると投稿しない)
# ⚠️ 氏名・学籍番号が投稿されるため、管理者と Bot だけが見られるチャンネルにすること
LOG_CHANNEL_NAME=authbot-logs
